prepare() {
	cd "${srcdir}/RapidOCR-${pkgver}/python"

	RAPIDOCR_PKGVER="${pkgver}" python - <<'PY'
import os
from pathlib import Path

import yaml

pyproject_path = Path("pyproject.toml")
pyproject = pyproject_path.read_text(encoding="utf-8")
pyproject = pyproject.replace('    "setuptools-scm>=8",\n', "")
pyproject = pyproject.replace(
    'dynamic = ["version", "dependencies"]',
    f'version = "{os.environ["RAPIDOCR_PKGVER"]}"\ndynamic = ["dependencies"]',
)
setuptools_scm_start = pyproject.find("\n[tool.setuptools_scm]\n")
if setuptools_scm_start != -1:
    pyproject = pyproject[:setuptools_scm_start].rstrip() + "\n"
pyproject_path.write_text(pyproject, encoding="utf-8")

multihead_path = Path(
    "rapidocr/inference_engine/pytorch/networks/heads/multiheadAttention.py"
)
multihead = multihead_path.read_text(encoding="utf-8")
multihead = multihead.replace(
    'class MultiheadAttention(nn.Module):\n    """Allows',
    'class MultiheadAttention(nn.Module):\n    r"""Allows',
    1,
)
multihead_path.write_text(multihead, encoding="utf-8")

model_dir = Path("/usr/share/rapidocr/models")
font_path = "/usr/share/rapidocr/fonts/FZYTK.TTF"
model_paths = {
    "PP-OCRv6_det_tiny.onnx": model_dir / "PP-OCRv6_det_tiny.onnx",
    "PP-OCRv6_rec_tiny.onnx": model_dir / "PP-OCRv6_rec_tiny.onnx",
    "PP-OCRv6_det_small.onnx": model_dir / "PP-OCRv6_det_small.onnx",
    "PP-OCRv6_rec_small.onnx": model_dir / "PP-OCRv6_rec_small.onnx",
    "PP-OCRv6_det_medium.onnx": model_dir / "PP-OCRv6_det_medium.onnx",
    "PP-OCRv6_rec_medium.onnx": model_dir / "PP-OCRv6_rec_medium.onnx",
    "ch_ppocr_mobile_v2.0_cls_mobile.onnx": model_dir / "ch_ppocr_mobile_v2.0_cls_mobile.onnx",
    "ch_PP-OCRv5_det_mobile.onnx": model_dir / "ch_PP-OCRv5_det_mobile.onnx",
    "ch_PP-OCRv5_rec_mobile.onnx": model_dir / "ch_PP-OCRv5_rec_mobile.onnx",
    "en_PP-OCRv5_rec_mobile.onnx": model_dir / "en_PP-OCRv5_rec_mobile.onnx",
    "ch_PP-OCRv5_det_server.onnx": model_dir / "ch_PP-OCRv5_det_server.onnx",
    "ch_PP-OCRv5_rec_server.onnx": model_dir / "ch_PP-OCRv5_rec_server.onnx",
    "arabic_PP-OCRv5_rec_mobile.onnx": model_dir / "arabic_PP-OCRv5_rec_mobile.onnx",
    "cyrillic_PP-OCRv5_rec_mobile.onnx": model_dir / "cyrillic_PP-OCRv5_rec_mobile.onnx",
    "devanagari_PP-OCRv5_rec_mobile.onnx": model_dir / "devanagari_PP-OCRv5_rec_mobile.onnx",
    "el_PP-OCRv5_rec_mobile.onnx": model_dir / "el_PP-OCRv5_rec_mobile.onnx",
    "eslav_PP-OCRv5_rec_mobile.onnx": model_dir / "eslav_PP-OCRv5_rec_mobile.onnx",
    "korean_PP-OCRv5_rec_mobile.onnx": model_dir / "korean_PP-OCRv5_rec_mobile.onnx",
    "latin_PP-OCRv5_rec_mobile.onnx": model_dir / "latin_PP-OCRv5_rec_mobile.onnx",
    "ta_PP-OCRv5_rec_mobile.onnx": model_dir / "ta_PP-OCRv5_rec_mobile.onnx",
    "te_PP-OCRv5_rec_mobile.onnx": model_dir / "te_PP-OCRv5_rec_mobile.onnx",
    "th_PP-OCRv5_rec_mobile.onnx": model_dir / "th_PP-OCRv5_rec_mobile.onnx",
}


def point_model_dirs_to_system_paths(data):
    if isinstance(data, dict):
        for key, value in data.items():
            if key == "model_dir" and isinstance(value, str):
                filename = Path(value).name
                if filename in model_paths:
                    data[key] = str(model_paths[filename])
                continue
            point_model_dirs_to_system_paths(value)
        return

    if isinstance(data, list):
        for value in data:
            point_model_dirs_to_system_paths(value)


default_models_path = Path("rapidocr/default_models.yaml")
default_models = yaml.safe_load(default_models_path.read_text())
point_model_dirs_to_system_paths(default_models)
default_models_path.write_text(yaml.safe_dump(default_models, sort_keys=False), encoding="utf-8")

config_path = Path("rapidocr/config.yaml")
config = yaml.safe_load(config_path.read_text())
config["Global"]["font_path"] = font_path
config["Global"]["model_root_dir"] = str(model_dir)
config["Det"].update(
    {
        "ocr_version": "PP-OCRv6",
        "model_type": "small",
        "model_path": str(model_paths["PP-OCRv6_det_small.onnx"]),
        "model_dir": None,
    }
)
config["Cls"].update(
    {
        "ocr_version": "PP-OCRv4",
        "model_type": "mobile",
        "model_path": str(model_paths["ch_ppocr_mobile_v2.0_cls_mobile.onnx"]),
        "model_dir": None,
    }
)
config["Rec"].update(
    {
        "ocr_version": "PP-OCRv6",
        "model_type": "small",
        "model_path": str(model_paths["PP-OCRv6_rec_small.onnx"]),
        "model_dir": None,
        "rec_keys_path": None,
    }
)
config_path.write_text(yaml.safe_dump(config, sort_keys=False), encoding="utf-8")
PY
}

build() {
	cd "${srcdir}/RapidOCR-${pkgver}/python"
	python -m build --wheel --no-isolation
}

# --- Helper Function to Install Models ---
_install_model() {
	local src_file="$1"
	local dest_dir="${pkgdir}/usr/share/rapidocr/models/"
	install -Dm644 "${srcdir}/${src_file}" "${dest_dir}/${src_file}"
}

_link_model_compat() {
	local target_file="$1"
	local link_file="$2"
	local dest_dir="${pkgdir}/usr/share/rapidocr/models/"
	ln -s "${target_file}" "${dest_dir}/${link_file}"
}

# --- Package Definitions ---

package_python-rapidocr() {
	depends=(
		'python'
		'python-pyclipper'
		'python-opencv'
		'python-numpy'
		'python-six'
		'python-shapely'
		'python-yaml'
		'python-pillow'
		'python-tqdm'
		'python-omegaconf'
		'python-requests'
		'python-colorlog'
		'rapidocr-fonts'
		'rapidocr-models-v6-small'
	)
	optdepends=(
		'python-openvino: Recommended runtime'
		'python-onnxruntime: Supported runtime'
		'python-onnxruntime-cpu: Faster than GPU-accelerated onnxruntime'
		'python-paddlepaddle: Supported runtime'
		'python-pytorch: Supported runtime'
		'rapidocr-models-v6-tiny: Smaller PP-OCRv6 models'
		'rapidocr-models-v6-medium: Larger PP-OCRv6 models'
		'rapidocr-models-mobile-base: PP-OCRv5 mobile compatibility models'
		'rapidocr-models-server: Server models for higher accuracy'
	)

	cd "${srcdir}/RapidOCR-${pkgver}/python"
	python -m installer --destdir="$pkgdir" dist/*.whl

	# Symlink the models directory from site-packages to /usr/share/rapidocr/models
	local site_packages=$(python -c 'import sys; print(".".join(map(str, sys.version_info[:2])))')
	local rapidocr_dir="${pkgdir}/usr/lib/python${site_packages}/site-packages/rapidocr"

	install -dm755 "${pkgdir}/usr/share/rapidocr/models"

	# Remove the empty models dir created during install
	rm -rf "${rapidocr_dir}/models"

	# Create the symlink
	ln -s /usr/share/rapidocr/models "${rapidocr_dir}/models"
}

package_rapidocr-fonts() {
	pkgdesc="Fonts for RapidOCR text visualization"

	local dest_dir="${pkgdir}/usr/share/rapidocr/fonts/"
	install -Dm644 "${srcdir}/FZYTK.TTF" "${dest_dir}/FZYTK.TTF"
}

package_rapidocr-models-common() {
	pkgdesc="Shared classifier model and dictionary for RapidOCR model packages"

	_install_model "ch_ppocr_mobile_v2.0_cls_mobile.onnx"
	_link_model_compat "ch_ppocr_mobile_v2.0_cls_mobile.onnx" "ch_ppocr_mobile_v2.0_cls_infer.onnx"

	# Owned here because both mobile-base and server need this identical file
	local dest_dir="${pkgdir}/usr/share/rapidocr/models/"
	install -Dm644 "${srcdir}/ppocrv5_dict.txt" "${dest_dir}/ppocrv5_dict.txt"
}

package_rapidocr-models-v6-tiny() {
	pkgdesc="PP-OCRv6 tiny detection and recognition models for RapidOCR"
	depends=('rapidocr-models-common')
	provides=('rapidocr-models')

	_install_model "PP-OCRv6_det_tiny.onnx"
	_install_model "PP-OCRv6_rec_tiny.onnx"
}

package_rapidocr-models-v6-small() {
	pkgdesc="PP-OCRv6 small detection and recognition models for RapidOCR"
	depends=('rapidocr-models-common')
	provides=('rapidocr-models')

	_install_model "PP-OCRv6_det_small.onnx"
	_install_model "PP-OCRv6_rec_small.onnx"
}

package_rapidocr-models-v6-medium() {
	pkgdesc="PP-OCRv6 medium detection and recognition models for RapidOCR"
	depends=('rapidocr-models-common')
	provides=('rapidocr-models')

	_install_model "PP-OCRv6_det_medium.onnx"
	_install_model "PP-OCRv6_rec_medium.onnx"
}

package_rapidocr-models-mobile-base() {
	pkgdesc="Mobile PP-OCRv5 compatibility models for RapidOCR"
	depends=('rapidocr-models-common')
	provides=('rapidocr-models')

	_install_model "ch_PP-OCRv5_det_mobile.onnx"
	_install_model "ch_PP-OCRv5_rec_mobile.onnx"
	_link_model_compat "ch_PP-OCRv5_det_mobile.onnx" "ch_PP-OCRv5_mobile_det.onnx"
	_link_model_compat "ch_PP-OCRv5_rec_mobile.onnx" "ch_PP-OCRv5_rec_mobile_infer.onnx"

	# ppocrv5_dict.txt comes from rapidocr-models-common
	local dest_dir="${pkgdir}/usr/share/rapidocr/models/"
	install -Dm644 "${srcdir}/required_for_whl_v3.0.0/resources/models/ppocr_keys_v1.txt" "${dest_dir}/ppocr_keys_v1.txt"
}

package_rapidocr-models-server() {
	pkgdesc="Server models (v5) for RapidOCR (Higher accuracy, larger size)"
	depends=('rapidocr-models-common')
	provides=('rapidocr-models')

	_install_model "ch_PP-OCRv5_det_server.onnx"
	_install_model "ch_PP-OCRv5_rec_server.onnx"
	_link_model_compat "ch_PP-OCRv5_det_server.onnx" "ch_PP-OCRv5_server_det.onnx"
	_link_model_compat "ch_PP-OCRv5_rec_server.onnx" "ch_PP-OCRv5_rec_server_infer.onnx"
}

